GEMINI_API_KEY=your_gemini_api_key_here
# Set GEMINI_API_KEY as a server-only env var in Vercel Project Settings (NOT VITE_ prefixed).
# For local dev, create a .env file with GEMINI_API_KEY and run `vercel dev` or set it in your shell.
# The client never sees this key; all Gemini calls are proxied via /api/gemini.
